    "settings.reset_routing.alert.message": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume, mute, and output device rules for all apps and System Alert Sound will be cleared and reset to follow default. App preferences will not be changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有应用与系统提示音的音量、静音及输出设备规则将被清除并恢复为默认跟随，软件偏好设置不会被重置。"
          }
        }
      }
    },
