    "permission.denied.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciaccona needs \"System Audio Recording\" permission to adjust volume and output devices per app. Allow Ciaccona in System Settings → Privacy & Security → Screen & System Audio Recording, then relaunch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciaccona 需要“系统录音”权限来单独调整各应用的音量和输出设备。请在「系统设置 → 隐私与安全性 → 录屏与系统录音」中允许 Ciaccona 后重新启动。"
          }
        }
      }
    },
    "permission.denied.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciaccona will quit because System Audio Recording permission was not granted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获得系统录音权限，Ciaccona 将退出。"
          }
        }
      }
    },
